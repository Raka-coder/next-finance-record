# Supabase Configuration (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Better Auth Secret (Generate via: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-better-auth-secret"

# Base URL Aplikasi (http://localhost:3000 untuk dev, domain Anda di produksi)
BETTER_AUTH_URL="http://localhost:3000"

# PostgreSQL Supabase Database Connection URI (Project Settings > Database > URI)
# Disarankan menggunakan IPv4 Pooler (port 5432 atau 6543)
DATABASE_URL="postgres://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Google Cloud OAuth 2.0 (Opsional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
